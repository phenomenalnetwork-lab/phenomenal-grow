// Phase 0 subset of §2.5 data model. Full model arrives in Phases 1-4.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  AGENT
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DNC
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  contacts    Contact[]
  activities  Activity[]
  invites     Invite[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
}

// Better Auth core tables (email+password). Never query cross-org here:
// org scoping lives in Membership + domain tables.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// Org invite: an OWNER invites an email address. The invitee claims it
// after signing in (matched on email). No email-sending in Phase 0 —
// the inviter shares the invite token/link out of band.
model Invite {
  id         String         @id @default(cuid())
  orgId      String
  email      String
  role       MembershipRole @default(AGENT)
  token      String         @unique @default(cuid())
  acceptedAt DateTime?
  createdAt  DateTime       @default(now())

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([orgId])
}

model Membership {
  id      String         @id @default(cuid())
  orgId   String
  userId  String
  role    MembershipRole @default(AGENT)
  active  Boolean        @default(true)

  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Contact {
  id             String        @id @default(cuid())
  orgId          String
  name           String
  phoneE164      String
  email          String?
  source         String?
  referredBy     String?
  status         ContactStatus @default(ACTIVE)
  assignedAgentId String?
  customFields   Json?
  attribution    Json?
  lastMessageAt  DateTime?
  nextActionAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tags       ContactTag[]
  notes      Note[]
  activities Activity[]
  pipelines  ContactPipeline[]
  followups  Followup[]
  enrollments Enrollment[]
  appointments Appointment[]

  @@unique([orgId, phoneE164])
  @@index([orgId, status])
  @@index([orgId, assignedAgentId])
}

// Tags describe a contact (Hot Lead, VIP...). Pipeline = journey (Phase 3).
model Tag {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())

  contacts ContactTag[]

  @@unique([orgId, name])
  @@index([orgId])
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model Note {
  id        String   @id @default(cuid())
  orgId     String
  contactId String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([orgId, contactId])
}

model SavedView {
  id        String   @id @default(cuid())
  orgId     String
  ownerId   String
  name      String
  filters   Json
  createdAt DateTime @default(now())

  @@index([orgId, ownerId])
}

enum PipelineOutcome {
  ONGOING
  CONVERTED
  NOT_CONVERTED
}

model ContactMerge {
  id          String   @id @default(cuid())
  orgId       String
  survivingId String
  mergedId    String
  snapshot    Json?
  actorId     String?
  createdAt   DateTime @default(now())

  @@index([orgId])
}

enum ConvStatus {
  OPEN
  CLOSED
}

enum MsgDirection {
  IN
  OUT
}

// Organisation-owned WhatsApp Business numbers (Meta Cloud API, direct).
// Tokens stored plaintext in Phase 2 — encrypt at rest before production.
model WhatsappNumber {
  id               String   @id @default(cuid())
  orgId            String
  label            String
  provider         String   @default("meta")
  providerNumberId String
  accessToken      String
  businessAccountId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  conversations Conversation[]

  @@unique([orgId, providerNumberId])
  @@index([providerNumberId])
}

model Conversation {
  id               String     @id @default(cuid())
  orgId            String
  contactId        String
  whatsappNumberId String
  status           ConvStatus @default(OPEN)
  assignedAgentId  String?
  needsReply       Boolean    @default(false)
  lastInboundAt    DateTime?
  lastOutboundAt   DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  number   WhatsappNumber @relation(fields: [whatsappNumberId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([orgId, status, updatedAt])
  @@index([orgId, contactId])
}

model Message {
  id                String       @id @default(cuid())
  orgId             String
  conversationId    String
  providerMessageId String       @unique
  direction         MsgDirection
  type              String       @default("text")
  body              String?
  mediaKey          String?
  mediaMime         String?
  sentAt            DateTime     @default(now())
  createdAt         DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

// Relationship journeys. A contact can ride several at once (visitor →
// volunteer) without duplicating the contact record.
model Pipeline {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  type      String   @default("custom")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages      Stage[]
  enrollments ContactPipeline[]

  @@index([orgId])
}

model Stage {
  id             String   @id @default(cuid())
  pipelineId     String
  name           String
  order          Int      @default(0)
  expectedAction String?
  isConversion   Boolean  @default(false)

  pipeline    Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  enrollments ContactPipeline[]

  @@index([pipelineId, order])
}

model ContactPipeline {
  id            String          @id @default(cuid())
  orgId         String
  contactId     String
  pipelineId    String
  stageId       String
  outcome       PipelineOutcome @default(ONGOING)
  outcomeReason String?
  enteredAt     DateTime        @default(now())
  convertedAt   DateTime?
  updatedAt     DateTime        @updatedAt

  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage    Stage    @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@unique([contactId, pipelineId])
  @@index([orgId, pipelineId, stageId])
  @@index([orgId, outcome])
}

// Manual follow-ups: "Call John tomorrow at 10 AM".
model Followup {
  id              String    @id @default(cuid())
  orgId           String
  contactId       String
  title           String
  dueAt           DateTime
  assignedAgentId String?
  doneAt          DateTime?
  createdAt       DateTime  @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([orgId, assignedAgentId, dueAt])
  @@index([orgId, contactId])
}

enum SequenceKind {
  GUIDED
  CUSTOM
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  STOPPED
  COMPLETED
}

// Follow-up sequences. postConversion sequences keep running after a
// conversion (customer onboarding); others stop when the contact converts.
model Sequence {
  id             String       @id @default(cuid())
  orgId          String
  name           String
  kind           SequenceKind @default(CUSTOM)
  postConversion Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  steps       SequenceStep[]
  enrollments Enrollment[]

  @@index([orgId])
}

model SequenceStep {
  id         String @id @default(cuid())
  sequenceId String
  dayOffset  Int    @default(0)
  order      Int    @default(0)
  body       String

  sequence    Sequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  @@index([sequenceId, order])
}

model Enrollment {
  id           String           @id @default(cuid())
  orgId        String
  sequenceId   String
  contactId    String
  status       EnrollmentStatus @default(ACTIVE)
  currentStep  Int              @default(0)
  enrolledAt   DateTime         @default(now())
  nextRunAt    DateTime?
  attempts     Int              @default(0)
  stopReason   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([orgId, status, nextRunAt])
  @@index([contactId, status])
}

model Activity {
  id        String   @id @default(cuid())
  orgId     String
  contactId String?
  type      String
  actorId   String?
  payload   Json?
  at        DateTime @default(now())

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([orgId, contactId])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NOSHOW
}

// Lightweight appointments (not a booking platform): date + time + type +
// assignee + status, linked to pipelines and confirm/remind nudges.
model Appointment {
  id         String            @id @default(cuid())
  orgId      String
  contactId  String
  date       DateTime
  time       String?
  type       String?
  assigneeId String?
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([orgId, assigneeId, date])
  @@index([orgId, contactId])
}

// Simple capture forms (website, QR, events): each maps to source +
// pipeline/stage/assignee/sequence. Public via unguessable token.
model CaptureForm {
  id         String   @id @default(cuid())
  orgId      String
  name       String
  token      String   @unique @default(cuid())
  fields     Json
  source     String   @default("Website")
  pipelineId String?
  stageId    String?
  assigneeId String?
  sequenceId String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId])
}
