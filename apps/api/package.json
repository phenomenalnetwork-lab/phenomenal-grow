    "test": "vitest run --config ../../vitest.config.ts --fileParallelism=false"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@pgrow/storage": "workspace:*",
    "@pgrow/types": "workspace:*",
    "@prisma/client": "5.22.0",
    "dotenv": "^18.0.7",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "pg-boss": "^10.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/node": "^20.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2"
  }
