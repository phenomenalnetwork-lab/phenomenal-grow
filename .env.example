# Copy to .env for local dev
DATABASE_URL="postgresql://pgrow:pgrow@localhost:5432/pgrow?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT="4000"
WEB_PORT="3000"

# Better Auth (apps/web)
BETTER_AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Meta WhatsApp Cloud API (direct, no BSP)
WHATSAPP_VERIFY_TOKEN="change-me"
WHATSAPP_APP_SECRET="change-me"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Cloudflare R2 (S3-compatible storage, replaces any Supabase use)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="pgrow-media"
R2_PUBLIC_URL=""
