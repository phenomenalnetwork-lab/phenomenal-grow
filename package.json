{
  "name": "phenomenal-grow",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma && pnpm --filter @pgrow/web exec prisma generate --schema ../../prisma/schema.prisma && pnpm --filter @pgrow/api exec prisma generate --schema ../../prisma/schema.prisma",
    "db:seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "5.22.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "onlyBuiltDependencies": [
    "@nestjs/core",
    "@prisma/engines",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
