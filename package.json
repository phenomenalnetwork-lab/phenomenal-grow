{
  "name": "phenomenal-grow",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
