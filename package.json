    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=20"
  },
  "onlyBuiltDependencies": [
    "@nestjs/core",
    "@prisma/engines",
    "esbuild",
    "prisma",
    "sharp"
  ]
}
